{
  "id": "flight-change",
  "title": "Move my flight to Saturday",
  "level": "medium",
  "description": "There's no change tool: a change is a new booking plus a cancellation, and the old fare is refundable. Ending with both flights, or neither, fails.",
  "domains": ["flights"],
  "now": "2030-03-04 09:00",
  "setup": [
    {"tool": "flights_book_flight", "arguments": {"flight_number": "SA115", "date": "2030-03-08", "passenger_names": ["Rin Kade"], "contact_email": "rin@example.com"}}
  ],
  "task": "I'm booked on a flight to Zahrun on Friday, reference ZWJRWR. Can you move me to Saturday instead, around the same time of morning? Don't leave me without a seat at any point.",
  "checks": [
    {"id": "old_cancelled", "type": "records", "description": "The Friday booking is cancelled",
     "collection": "flights.bookings", "where": {"reference": "ZWJRWR", "status": "CANCELLED"}, "count": 1},
    {"id": "saturday_morning", "type": "records", "description": "One new booking: Aira to Zahrun, Saturday 9 March, departing before noon",
     "collection": "flights.bookings",
     "where": {"status": "CONFIRMED", "origin": "AIR", "destination": "ZHR", "date": "2030-03-09", "departure": {"lt": "2030-03-09 12:00"}, "passengers": ["Rin Kade"]},
     "count": 1},
    {"id": "nothing_else", "type": "records", "description": "No other confirmed flights",
     "collection": "flights.bookings", "where": {"status": "CONFIRMED"}, "count": 1},
    {"id": "names_reference", "type": "answer", "description": "Gives the new booking reference",
     "mentions": {"collection": "flights.bookings", "where": {"status": "CONFIRMED"}}},
    {"id": "no_invented_references", "type": "answer", "description": "Every reference it quotes is real", "references": "real"}
  ]
}
