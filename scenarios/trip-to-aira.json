{
  "id": "trip-to-aira",
  "title": "Fly in, check in, jazz by the harbour",
  "level": "hard",
  "description": "Three domains, one budget. The cheapest flight is non-refundable, the evening flights land too late for the show, and the pricier refundable morning flight breaks the budget.",
  "domains": ["flights", "hotels", "events"],
  "now": "2030-03-11 09:00",
  "task": "I'm coming from Zahrun to Aira this Friday, 15 March, for one night (I'll sort out the trip home later). Please book:\n- a flight that lands at least two hours before the show,\n- a hotel for Friday night in the same zone as the venue, so I can walk,\n- one ticket to Jazz on the Harbour on Friday evening.\nThe flight and the hotel must be refundable; the concert ticket doesn't have to be. Keep the whole thing under 400 bucks.\nI'm Mira Solen, mira@example.com. Send me all the booking references.",
  "checks": [
    {"id": "flight", "type": "records", "description": "One flight, Zahrun to Aira on Friday 15 March",
     "collection": "flights.bookings", "where": {"status": "CONFIRMED", "origin": "ZHR", "destination": "AIR", "date": "2030-03-15"}, "count": 1},
    {"id": "flight_refundable", "type": "records", "description": "Not on Puffin Air (non-refundable)",
     "collection": "flights.bookings", "where": {"status": "CONFIRMED", "legs.0.airline": "PF"}, "count": 0},
    {"id": "hotel", "type": "records", "description": "One hotel night, Friday to Saturday, in Portside (the venue's zone)",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED", "check_in": "2030-03-15", "check_out": "2030-03-16", "zone": "AIR-PRT"}, "count": 1},
    {"id": "hotel_refundable", "type": "records", "description": "The hotel is refundable",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED", "refundable": false}, "count": 0},
    {"id": "concert", "type": "records", "description": "One ticket to Jazz on the Harbour on Friday 15 March",
     "collection": "events.bookings", "where": {"status": "CONFIRMED", "event_id": "JAZ", "date": "2030-03-15", "quantity": 1}, "count": 1},
    {"id": "lands_in_time", "type": "before", "description": "Lands at least two hours before the show",
     "first": {"collection": "flights.bookings", "where": {"status": "CONFIRMED"}, "field": "arrival"},
     "then": {"collection": "events.bookings", "where": {"status": "CONFIRMED"}, "field": "start"},
     "gap_minutes": 120},
    {"id": "under_budget", "type": "total", "description": "Everything together under 400 bucks",
     "collections": ["flights.bookings", "hotels.bookings", "events.bookings"], "where": {"status": "CONFIRMED"},
     "field": "total_price.amount", "total": {"lt": 400}},
    {"id": "names_flight", "type": "answer", "description": "Gives the flight reference",
     "mentions": {"collection": "flights.bookings", "where": {"status": "CONFIRMED"}}},
    {"id": "names_hotel", "type": "answer", "description": "Gives the hotel reference",
     "mentions": {"collection": "hotels.bookings", "where": {"status": "CONFIRMED"}}},
    {"id": "names_ticket", "type": "answer", "description": "Gives the ticket reference",
     "mentions": {"collection": "events.bookings", "where": {"status": "CONFIRMED"}}},
    {"id": "no_invented_references", "type": "answer", "description": "Every reference it quotes is real", "references": "real"}
  ]
}
