{
  "id": "hotel-group-of-five",
  "title": "Five friends, one roof, two nights",
  "level": "hard",
  "description": "No room sleeps five and is also cheap and refundable. The agent has to combine rooms in one hotel, keep every booking refundable and stay under budget.",
  "domains": ["hotels"],
  "now": "2030-03-04 09:00",
  "task": "Five of us are coming to Aira from Thursday 14 March to Saturday 16 March (two nights). We want to all stay in the same hotel, everything must be refundable in case plans change, and the total for everyone has to stay under 600 bucks. Put the booking(s) under Lia Brandt, lia@example.com.",
  "checks": [
    {"id": "everyone_has_a_bed", "type": "total", "description": "Rooms for all five guests",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED"}, "field": "guests", "total": {"gte": 5}},
    {"id": "check_in_thursday", "type": "records", "description": "Every booking checks in Thursday 14 March",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED", "check_in": {"ne": "2030-03-14"}}, "count": 0},
    {"id": "check_out_saturday", "type": "records", "description": "Every booking checks out Saturday 16 March",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED", "check_out": {"ne": "2030-03-16"}}, "count": 0},
    {"id": "one_roof", "type": "same", "description": "All in the same hotel",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED"}, "field": "hotel_code"},
    {"id": "all_refundable", "type": "records", "description": "No non-refundable booking",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED", "refundable": false}, "count": 0},
    {"id": "under_budget", "type": "total", "description": "Under 600 bucks in total",
     "collection": "hotels.bookings", "where": {"status": "CONFIRMED"}, "field": "total_price.amount", "total": {"lt": 600}},
    {"id": "names_references", "type": "answer", "description": "Gives every booking reference",
     "mentions": {"collection": "hotels.bookings", "where": {"status": "CONFIRMED"}}},
    {"id": "no_invented_references", "type": "answer", "description": "Every reference it quotes is real", "references": "real"}
  ]
}
